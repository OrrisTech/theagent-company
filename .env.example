# The Agent Company (TAC) — Environment Configuration
# Copy this file to .env and fill in the required values.

# =============================================================================
# REQUIRED
# =============================================================================

# At least one LLM API key is required for agent execution:
# (Local CLI adapters can use subscription auth instead of API keys)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Auth secret for session encryption (generate: openssl rand -hex 32)
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================

# Deployment mode: "local_trusted" or "authenticated"
# - local_trusted: no auth required, for development only
# - authenticated: requires login, for production
TAC_DEPLOYMENT_MODE=authenticated

# Exposure level: "private" or "public"
TAC_DEPLOYMENT_EXPOSURE=private

# Public URL for auth callbacks (required for authenticated mode with OAuth)
# TAC_PUBLIC_URL=https://your-domain.com

# =============================================================================
# SERVER
# =============================================================================

HOST=0.0.0.0
PORT=3100
SERVE_UI=true

# =============================================================================
# DATABASE
# =============================================================================

# External PostgreSQL connection string
# Required in cloud/Docker mode. If unset, embedded PostgreSQL is used (local only).
# DATABASE_URL=postgres://tac:tac@localhost:5432/tac

# =============================================================================
# CLOUD MODE (optional)
# =============================================================================

# Set to "true" to enable cloud mode:
# - Local CLI adapters hidden from engine selection
# - Embedded PostgreSQL disabled (requires DATABASE_URL)
# - Runtime services (dev server spawning) disabled
# Auto-detected when running inside Docker containers.
# TAC_CLOUD_MODE=true

# =============================================================================
# STORAGE
# =============================================================================

# Storage provider: "local_disk" or "s3"
TAC_STORAGE_PROVIDER=local_disk

# S3 settings (when TAC_STORAGE_PROVIDER=s3)
# TAC_STORAGE_S3_BUCKET=tac-data
# TAC_STORAGE_S3_REGION=us-east-1
# TAC_STORAGE_S3_ENDPOINT=
# TAC_STORAGE_S3_PREFIX=
# TAC_STORAGE_S3_FORCE_PATH_STYLE=false

# =============================================================================
# SECRETS
# =============================================================================

# Secrets provider: "local_encrypted" or "env_only"
TAC_SECRETS_PROVIDER=local_encrypted

# =============================================================================
# OPTIONAL — Advanced
# =============================================================================

# Disable user sign-up (admin-only user creation)
# TAC_AUTH_DISABLE_SIGN_UP=true

# Company deletion (dangerous, off by default)
# TAC_ENABLE_COMPANY_DELETION=true

# Database auto-backup
# TAC_DB_BACKUP_ENABLED=true
# TAC_DB_BACKUP_INTERVAL_MINUTES=60
# TAC_DB_BACKUP_RETENTION_DAYS=7

# Runtime services (dev server spawning) — auto-disabled in cloud mode
# TAC_RUNTIME_SERVICES_ENABLED=true

# Allowed hostnames for CORS (comma-separated)
# TAC_ALLOWED_HOSTNAMES=localhost,127.0.0.1
